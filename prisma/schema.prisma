// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String        @id @default(cuid())
  name                     String?
  email                    String        @unique
  emailVerified            DateTime?
  password                 String?
  image                    String?
  phone                    String?
  role                     Role          @default(USER)
  verificationToken        String?       @unique
  verificationTokenExpiry  DateTime?
  resetToken               String?       @unique
  resetTokenExpiry         DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  
  accounts      Account[]
  sessions      Session[]
  appointments  Appointment[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Service {
  id            String        @id @default(cuid())
  name          String
  description   String        @db.Text
  price         Float
  compareAtPrice Float?
  duration      Int // in minutes
  image         String?
  categories    String[]      @default([])
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  appointments  Appointment[]

  @@map("services")
}

model ServiceCategory {
  id        String   @id @default(cuid())
  value     String   @unique
  label     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("service_categories")
}

model ProductCategoryModel {
  id        String    @id @default(cuid())
  value     String    @unique
  label     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("product_categories")
}

model Appointment {
  id          String            @id @default(cuid())
  userId      String
  serviceId   String
  date        DateTime
  startTime   String
  endTime     String
  status      AppointmentStatus @default(PENDING)
  notes       String?           @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  service     Service           @relation(fields: [serviceId], references: [id])
  products    AppointmentProduct[]

  @@index([userId])
  @@index([serviceId])
  @@index([date])
  @@map("appointments")
}

model AppointmentProduct {
  id            String      @id @default(cuid())
  appointmentId String
  productId     String
  quantity      Int         @default(1)
  createdAt     DateTime    @default(now())
  
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  product       Product     @relation(fields: [productId], references: [id])

  @@unique([appointmentId, productId])
  @@index([appointmentId])
  @@index([productId])
  @@map("appointment_products")
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String      @db.Text
  price       Float
  compareAtPrice Float?
  images      String[]
  categories  String[]    // Array of categories - product appears in all selected categories
  categoryId  String?
  brand       String?
  stock       Int         @default(0)
  isActive    Boolean     @default(true)
  isFeatured  Boolean     @default(false)
  tags        String[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  appointments AppointmentProduct[]
  productCategory ProductCategoryModel? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([isFeatured])
  @@map("products")
}

// Content Management Models
model HeroContent {
  id        String   @id @default(cuid())
  slides    Json     // Array of hero slides with title, subtitle, description, colorScheme, cta
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hero_content")
}

model FeaturesContent {
  id               String   @id @default(cuid())
  badgeText        String?
  headingPrefix    String?
  headingHighlight String?
  description      String?
  features         Json     // Array of features with icon, title, description
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("features_content")
}

model WhyChooseUsContent {
  id        String   @id @default(cuid())
  reasons   Json     // Array of reasons with icon, title, description
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("why_choose_us_content")
}

model TestimonialsContent {
  id            String   @id @default(cuid())
  testimonials  Json     // Array of testimonials with name, role, rating, text, image, ringColor
  sectionHeader Json?    // Section header configuration including cardsPerRow
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("testimonials_content")
}

model FaqContent {
  id            String   @id @default(cuid())
  faqs          Json     // Array of FAQs with question, answer
  sectionHeader Json?    // Section header with badge, titlePrefix, titleHighlight, subtitle, ctaText, ctaButtonText, ctaButtonLink
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("faq_content")
}

model CtaContent {
  id              String   @id @default(cuid())
  badge           String   @default("Book Now & Get Started")
  title           String
  description     String   @db.Text
  buttonText      String
  buttonHref      String
  leadingIcon     String?  // Optional name or URL for leading icon
  trailingIcon    String?  // Optional name or URL for trailing icon
  trustIndicators String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("cta_content")
}

model Notification {
  id        String   @id @default(cuid())
  type      NotificationType
  title     String
  message   String   @db.Text
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

enum Role {
  USER
  ADMIN
  STAFF
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum NotificationType {
  APPOINTMENT
  PRODUCT
  SYSTEM
}
